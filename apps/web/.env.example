# Web app (apps/web) environment. Vite embeds VITE_* values in the public bundle:
# never put secrets here.

# API base used by the SPA (apps/web/src/lib/api.ts).
#   Local dev (through the Vite proxy): /api/v1 (default when unset)
VITE_API_BASE=/api/v1

# Dev proxy target for `npm run dev` (apps/web/vite.config.ts).
# Default: http://localhost:3000 (NestJS, full mode).
# Standalone mode (FastAPI also serves /api/v1): http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:3000
