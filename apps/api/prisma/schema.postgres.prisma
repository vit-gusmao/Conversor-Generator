// Production Prisma schema (PostgreSQL).
// Copy over prisma/schema.prisma before `prisma generate` in a Postgres
// deployment, e.g.:
//   cp prisma/schema.postgres.prisma prisma/schema.prisma
// Models are identical to the SQLite variant: JSON payloads stay TEXT so the
// repository code is provider agnostic (switch to Json + GIN when needed).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("API_POSTGRES_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  role         String   @default("owner")
  isAnonymous  Boolean  @default(false)
  deviceId     String?  @unique
  createdAt    DateTime @default(now())

  documents   Document[]
  conversions Conversion[]
  keys        IdempotencyKey[]

  @@index([createdAt])
}

model Document {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String
  pageCount  Int?
  ownerId    String
  createdAt  DateTime @default(now())

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversions Conversion[]

  @@index([sha256])
  @@index([ownerId, createdAt])
}

model Conversion {
  id             String    @id @default(uuid())
  documentId     String
  ownerId        String
  status         String    @default("received")
  quality        String    @default("pending")
  progress       Float     @default(0)
  stage          String    @default("receive")
  activeRunId    String?
  errorCode      String?
  errorMessage   String?
  statsJson      String?
  validationJson String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs     ConversionRun[]
  events   ConversionEvent[]
  keys     IdempotencyKey[]

  @@index([ownerId, createdAt])
  @@index([status])
  @@index([ownerId, status])
}

model ConversionRun {
  id            String    @id @default(uuid())
  conversionId  String
  attempt       Int
  status        String    @default("received")
  progress      Float     @default(0)
  stage         String    @default("receive")
  startedAt     DateTime?
  finishedAt    DateTime?
  engineVersion String?
  configJson    String?
  errorCode     String?
  errorMessage  String?
  statsJson     String?
  createdAt     DateTime  @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, attempt])
  @@index([conversionId])
  @@index([status])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  ownerId      String
  conversionId String
  requestHash  String
  createdAt    DateTime @default(now())

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([ownerId, key])
  @@index([conversionId])
}

model ConversionEvent {
  id           String   @id @default(uuid())
  conversionId String
  sequence     Int
  type         String
  status       String
  stage        String
  progress     Float    @default(0)
  message      String
  payloadJson  String?
  createdAt    DateTime @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, sequence])
  @@index([conversionId, sequence])
}

model OutboxEvent {
  id           String    @id @default(uuid())
  type         String
  payloadJson  String
  status       String    @default("pending")
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  lastError    String?

  @@index([status, availableAt])
  @@index([createdAt])
}
