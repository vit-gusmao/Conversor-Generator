// Prisma schema — SQLite (development / single-node deployment).
// Production PostgreSQL variant: ./schema.postgres.prisma (identical models).
//
// NOTE: JSON payloads are stored as TEXT (String) on both providers so the
// repository code is provider-agnostic. See src/database for the JSON helpers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("API_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  role         String   @default("owner")
  isAnonymous  Boolean  @default(false)
  // Deterministic identity for anonymous (device) sessions, sent as `x-device-id`.
  deviceId     String?  @unique
  createdAt    DateTime @default(now())

  documents   Document[]
  conversions Conversion[]
  keys        IdempotencyKey[]
  batches     Batch[]
  uploads     UploadSession[]
}

model Document {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String
  pageCount  Int?
  ownerId    String
  createdAt  DateTime @default(now())

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversions Conversion[]

  @@index([sha256])
  @@index([ownerId, createdAt])
}

model Conversion {
  id             String    @id @default(uuid())
  documentId     String
  ownerId        String
  status         String    @default("received")
  quality        String    @default("pending")
  progress       Float     @default(0)
  stage          String    @default("receive")
  activeRunId    String?
  errorCode      String?
  errorMessage   String?
  statsJson      String?
  validationJson String?
  // Canonical ConversionOptionsV2 used by this conversion, so a retry reuses
  // exactly what the user asked for instead of falling back to defaults.
  optionsJson    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document  Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs      ConversionRun[]
  events    ConversionEvent[]
  keys      IdempotencyKey[]
  batchItem BatchItem?

  @@index([ownerId, createdAt])
  @@index([status])
  @@index([ownerId, status])
}

model ConversionRun {
  id            String    @id @default(uuid())
  conversionId  String
  attempt       Int
  status        String    @default("received")
  progress      Float     @default(0)
  stage         String    @default("receive")
  startedAt     DateTime?
  finishedAt    DateTime?
  engineVersion String?
  configJson    String?
  errorCode     String?
  errorMessage  String?
  statsJson     String?
  createdAt     DateTime  @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, attempt])
  @@index([conversionId])
  @@index([status])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  ownerId      String
  conversionId String
  requestHash  String
  createdAt    DateTime @default(now())

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([ownerId, key])
  @@index([conversionId])
}

model ConversionEvent {
  id           String   @id @default(uuid())
  conversionId String
  sequence     Int
  type         String
  status       String
  stage        String
  progress     Float    @default(0)
  message      String
  payloadJson  String?
  createdAt    DateTime @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, sequence])
  @@index([conversionId, sequence])
}

model OutboxEvent {
  id           String    @id @default(uuid())
  type         String
  payloadJson  String
  status       String    @default("pending")
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  lastError    String?
  // Dispatch lease: one API instance owns the row until `lockedUntil`.
  lockedBy     String?
  lockedUntil  DateTime?

  @@index([status, availableAt])
  @@index([status, lockedUntil])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Batches (unbounded multi-file submissions)
// ---------------------------------------------------------------------------

model Batch {
  id                String    @id @default(uuid())
  ownerId           String
  clientBatchKey    String
  status            String    @default("accepting")
  // Optimistic-concurrency version, bumped on every state change.
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sealedAt          DateTime?
  cancelRequestedAt DateTime?

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items BatchItem[]
  events BatchEvent[]

  @@unique([ownerId, clientBatchKey])
  @@index([ownerId, createdAt, id])
  @@index([status])
}

model BatchItem {
  id                 String   @id @default(uuid())
  batchId            String
  clientItemId       String
  ordinal            Int
  filename           String
  sizeBytes          Int
  // Declared kind; the server re-detects the real content before accepting.
  kind               String   @default("pdf")
  optionsJson        String
  // Hash of canonical options + filename + size, for divergent replay detection.
  requestFingerprint String
  uploadId           String?  @unique
  conversionId       String?  @unique
  status             String   @default("pending_upload")
  errorJson          String?
  pagesTotal         Int?
  pagesAttempted     Int?
  pagesCompleted     Int?
  pagesFailed        Int?
  phase              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batch      Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Pointer to the session the client is currently filling.
  upload     UploadSession? @relation("ItemActiveUpload", fields: [uploadId], references: [id], onDelete: SetNull)
  uploads    UploadSession[] @relation("ItemUploads")
  conversion Conversion?    @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@unique([batchId, clientItemId])
  @@index([batchId, ordinal, id])
  @@index([conversionId])
  @@index([status])
}

model UploadSession {
  id            String   @id @default(uuid())
  ownerId       String
  itemId        String
  filename      String
  expectedBytes Int
  receivedBytes Int      @default(0)
  // Transport parameter (8 MiB by default), never a document ceiling.
  partSize      Int
  sha256        String?
  state         String   @default("pending")
  expiresAt     DateTime
  storageKey    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  item  BatchItem  @relation("ItemUploads", fields: [itemId], references: [id], onDelete: Cascade)
  // Back-relation of `BatchItem.uploadId`; no extra column on this side.
  activeForItem BatchItem? @relation("ItemActiveUpload")
  parts UploadPart[]

  @@index([ownerId, state, expiresAt])
  @@index([itemId, state])
  @@index([state, expiresAt])
}

model UploadPart {
  id         String   @id @default(uuid())
  uploadId   String
  partNumber Int
  size       Int
  sha256     String
  storageKey String
  createdAt  DateTime @default(now())

  upload UploadSession @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, partNumber])
  @@index([uploadId, partNumber])
}

model BatchEvent {
  id           String   @id @default(uuid())
  batchId      String
  sequence     Int
  type         String
  itemId       String?
  status       String
  itemStatus   String?
  message      String   @default("")
  payloadJson  String?
  createdAt    DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sequence])
  @@index([batchId, sequence])
}
