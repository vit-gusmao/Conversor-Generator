# ============================================================================
# PDF -> Excel Platform - environment
# Copy to .env and adjust. Every service reads the same file.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime mode
#   standalone : a single FastAPI process also exposes /api/v1 and serves the
#                built frontend. SQLite + local storage + inline worker.
#                No Docker, no Redis, no Postgres required.
#   full       : NestJS public API + FastAPI internal API + Celery/Redis +
#                PostgreSQL + MinIO. Stack local completa: infra/docker-compose.yml.
# ---------------------------------------------------------------------------
RUNTIME_MODE=standalone

# ---------------------------------------------------------------------------
# Web / API
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
# Public API URL as used locally (localhost only).
PUBLIC_API_URL=http://localhost:3000
# In standalone mode the API is served by the converter service:
CONVERTER_PUBLIC_URL=http://localhost:8000

# Build-time base of the SPA (apps/web). Leave it as /api/v1 for
# local dev, which goes through the Vite proxy.
VITE_API_BASE=/api/v1

# ---------------------------------------------------------------------------
# NestJS public API
# ---------------------------------------------------------------------------
API_PORT=3000
# Interface de bind da API. 127.0.0.1 = so esta maquina. Use 0.0.0.0 apenas dentro de containers.
API_HOST=127.0.0.1
API_DATABASE_URL=file:./data/api.db
# Base URL of the Python engine as seen from the API process (full mode).
CONVERTER_INTERNAL_URL=http://localhost:8000
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=7d
# Sessão local: cada navegador tem seu owner (cookie HttpOnly + device id).
# Não há cadastro/login/senha. `required` aceita JWT de emissor confiável.
# optional | required
AUTH_MODE=optional
# Limite do endpoint legado de upload em uma unica requisicao (50 MiB).
# O caminho novo (lotes + partes) NAO usa este limite.
UPLOAD_MAX_BYTES=52428800
# obsoleto: nao ha teto de paginas. Deixe vazio para processar o documento inteiro.
# Um valor positivo aqui so se aplica se LARGE_DOCUMENT_PIPELINE_ENABLED=false,
# e gera aviso de configuracao obsoleta.
#UPLOAD_MAX_PAGES=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Lotes e envio por partes (resumable) ----------------------------------
BATCH_UPLOAD_ENABLED=true
LARGE_DOCUMENT_PIPELINE_ENABLED=true
RESULT_COMPACT_ENABLED=true
MCP_ENABLED=true
# Tamanho da parte enviada (parametro de transporte, nao limite de documento).
UPLOAD_PART_BYTES=8388608
UPLOAD_PART_MAX_BYTES=33554432
UPLOAD_CONCURRENCY=3
# Vazio/null = sem teto de produto. Nao e um limite de admissao silencioso.
#MAX_FILES_PER_BATCH=
#UPLOAD_MAX_FILE_BYTES=
#UPLOAD_MAX_DOCUMENT_BYTES=
UPLOAD_SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Python converter
# ---------------------------------------------------------------------------
CONVERTER_PORT=8000
CONVERTER_DATABASE_URL=sqlite:///./data/converter.db
CONVERTER_INTERNAL_TOKEN=dev-internal-token-change-me
CONVERTER_QUEUE=inline         # inline | celery
CONVERTER_WORKERS=2
# 0 desativa o prazo global do documento: o processamento e incremental e o
# timeout passa a ser por unidade (ver CONVERTER_OCR_CALL_TIMEOUT_SECONDS).
CONVERTER_TASK_TIMEOUT_SECONDS=0
# obsoleto: nao ha teto de paginas (vazio = documento inteiro).
#CONVERTER_MAX_PAGES=
# Janela de paginas por checkpoint (justica e latencia, nao limite).
CONVERTER_PAGE_WINDOW=25
# Timeout de UMA chamada de OCR (unidade), nao do documento inteiro.
CONVERTER_OCR_CALL_TIMEOUT_SECONDS=300
# Reaproveita checkpoints por pagina quando a mesma execucao e retomada.
CHECKPOINT_REUSE_ENABLED=true
CONVERTER_MAX_PDF_BYTES=52428800
CONVERTER_RENDER_DPI=300
CONVERTER_OCR_ENABLED=true
# CONVERTER_OCR_ENGINE e TESSERACT_CMD sao lidos direto do ambiente do processo (os.environ),
# nao pelo Settings do conversor: exporte-os no shell/servico em vez de depender so deste arquivo.
# Path to the tesseract binary when it is not on PATH (Windows example below).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CONVERTER_OCR_MIN_CONFIDENCE=0.45
CONVERTER_OCR_MAX_PIXELS=40000000
CONVERTER_MAX_FALLBACK_ATTEMPTS=2
# Motor preferencial: glm-ocr | rapidocr | tesseract (vazio = automatico:
# glm-ocr quando o Ollama estiver no ar com o modelo, senao os demais)
#CONVERTER_OCR_ENGINE=

# --- OCR: GLM-OCR (VLM local via Ollama, 100% GPU) -------------------------
# Motor preferencial para paginas digitalizadas (GLM-OCR via Ollama).
# Instale o modelo com:  ollama pull glm-ocr:latest
# A GPU e usada automaticamente pelo Ollama quando ha VRAM (verifique: ollama ps).
GLMOCR_ENABLED=true
GLMOCR_HOST=127.0.0.1
GLMOCR_PORT=11434
GLMOCR_MODEL=glm-ocr:latest
GLMOCR_REQUEST_TIMEOUT=300
GLMOCR_NUM_CTX=8192
GLMOCR_NUM_PREDICT=4096
GLMOCR_KEEP_ALIVE=30m
# Vazio = offload automatico de todas as camadas para a GPU (recomendado)
#GLMOCR_NUM_GPU=
# Confianca constante atribuida as palavras do VLM (sem confianca por token)
GLMOCR_CONFIDENCE=0.90
GLMOCR_PROBE_CACHE_SECONDS=60

# ---------------------------------------------------------------------------
# Generalized formats (same IR, no repeated OCR)
# ---------------------------------------------------------------------------
CONVERTER_TARGET_FORMATS=xlsx,txt,csv
CONVERTER_MAX_IMAGE_FRAMES=500
CONVERTER_MAX_IMAGE_MEGAPIXELS=40
CONVERTER_MAX_JOB_MEGAPIXELS=200

# ---------------------------------------------------------------------------
# Local assistant: Qwen3.5-4B via Ollama (optional; conversions never depend)
#   ollama pull qwen3.5:4b
# The GUI never downloads a model on page load.
# ---------------------------------------------------------------------------
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=ollama
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=11434
ASSISTANT_MODEL=qwen3.5:4b
ASSISTANT_CONTEXT_TOKENS=8192
ASSISTANT_MAX_OUTPUT_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_MAX_CONCURRENT=1
# Qwen3.5 emits a long thinking stream by default; keep it off so the answer
# is not starved of output tokens.
ASSISTANT_THINKING=false
ASSISTANT_REQUIRE_SOURCES=true
EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Storage: local | s3
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pdf2x
S3_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL / Redis (full mode)
# ---------------------------------------------------------------------------
POSTGRES_USER=pdf2x
POSTGRES_PASSWORD=pdf2x
POSTGRES_DB=pdf2x
# Used only by apps/api/prisma/schema.postgres.prisma
API_POSTGRES_URL=postgresql://pdf2x:pdf2x@postgres:5432/pdf2x?schema=api
# Converter Postgres (read as CONVERTER_DATABASE_URL, see infra/docker-compose.yml):
# CONVERTER_DATABASE_URL=postgresql+psycopg://pdf2x:pdf2x@postgres:5432/pdf2x_conv
REDIS_URL=redis://redis:6379/0
# Callback do conversor para a API (full mode). Dentro do compose a API e http://api:3000;
# rodando no host, use http://localhost:3000.
#CONVERTER_CALLBACK_URL=http://localhost:3000/api/v1/internal/hooks/converter

# ---------------------------------------------------------------------------
# Retention / privacy
# ---------------------------------------------------------------------------
RETENTION_PDF_DAYS=7
RETENTION_XLSX_DAYS=30
RETENTION_AUDIT_DAYS=90
ARTIFACT_COMPRESSION=true

# ---------------------------------------------------------------------------
# Upgrade features (fontes por caminho, planilhas, agendador)
# ---------------------------------------------------------------------------
# Publicadas em /capabilities como "features" (flags efetivas, nao so a var).
# Desabilitar nao apaga definicoes/historico; apenas recusa trabalho novo.
SOURCE_IMPORTS_ENABLED=true
SPREADSHEET_INPUT_ENABLED=true
# Executor de calendario/automacao inline. O desktop liga isto no perfil
# gerenciado; no modo full use o processo dedicado (python -m automation.cli).
AUTOMATION_EXECUTOR_ENABLED=false
AUTOMATION_POLL_SECONDS=5
# Retencao do historico de automacao (nunca toca originais/artefatos).
AUTOMATION_HISTORY_RETENTION_DAYS=90
AUTOMATION_FAILURE_RETENTION_DAYS=7
# Capacidade de host desktop (concessao de raizes via credencial do host).
DESKTOP_HOST_ENABLED=false

# Diretorios explicitos do runtime empacotado. O supervisor Electron passa
# caminhos absolutos no userData; nada mutavel fica em Program Files/resources.
# APP_DATA_DIR=C:/Users/voce/AppData/Roaming/Conversor Generator
# WORK_DIR=
# LOG_DIR=
# WEB_DIST_DIR=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Structured JSON logs in the converter (1/true/yes). Lido via os.getenv: exporte no ambiente do processo.
# LOG_JSON=1

# ---------------------------------------------------------------------------
# Checklist antes de usar (troque os placeholders se outras pessoas usam esta maquina)
#   - JWT_SECRET                : string longa e aleatoria; no modo full, o mesmo valor nos dois servicos
#   - CONVERTER_INTERNAL_TOKEN  : string longa e aleatoria, compartilhada entre API e conversor
#   - ALLOWED_ORIGINS           : origem exata do SPA, ex.: http://localhost:5173 (sem barra final),
#                                 nos dois servicos (API e conversor)
#   - PUBLIC_API_URL / WEB_ORIGIN : URLs locais (http://localhost:3000 / http://localhost:5173)
#   - Binds: mantenha API_HOST e PDF2X_MCP_HOST em 127.0.0.1 (0.0.0.0 so dentro de containers)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MCP adapter (apps/mcp) — lets an LLM host submit and track documents
# ---------------------------------------------------------------------------
# Root of the local API. Both http://host:port and http://host:port/api/v1
# are accepted; the /api/v1 prefix is applied exactly once by the adapter.
PDF2X_API_BASE_URL=http://localhost:8000
# Optional fixed device identity. Leave unset to let the adapter generate one
# and persist it in PDF2X_CONFIG_DIR/identity.json (mode 0600).
# Setting PDF2X_DEVICE_ID to the browser's pdf2x.device_id (localStorage)
# makes the MCP conversions appear in the same history as the web UI.
# PDF2X_DEVICE_ID=
# Holds identity.json and submissions.jsonl. Never commit or sync this folder.
PDF2X_CONFIG_DIR=~/.pdf2x
# Comma-separated absolute directories the adapter may read documents from and
# write artifacts to. Empty = the current user's home directory.
PDF2X_ALLOWED_ROOTS=
# Global part-upload concurrency across all documents (1-32).
PDF2X_TRANSFER_CONCURRENCY=3
# stdio (Claude Desktop and most hosts) or http (Streamable HTTP at /mcp).
PDF2X_MCP_TRANSPORT=stdio
PDF2X_MCP_PORT=7801
# Interface do transporte http. 127.0.0.1 = so esta maquina.
#PDF2X_MCP_HOST=127.0.0.1

