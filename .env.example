# ============================================================================
# PDF -> Excel Platform - environment
# Copy to .env and adjust. Every service reads the same file.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime mode
#   standalone : a single FastAPI process also exposes /api/v1 and serves the
#                built frontend. SQLite + local storage + inline worker.
#                No Docker, no Redis, no Postgres required.
#   full       : NestJS public API + FastAPI internal API + Celery/Redis +
#                PostgreSQL + MinIO. This is the production layout.
# ---------------------------------------------------------------------------
RUNTIME_MODE=standalone

# ---------------------------------------------------------------------------
# Web / API
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# In standalone mode the public API is served by the converter service:
CONVERTER_PUBLIC_URL=http://localhost:8000

# Build-time base of the SPA (apps/web). Vercel: https://<backend-host>/api/v1
VITE_API_BASE=/api/v1

# ---------------------------------------------------------------------------
# NestJS public API
# ---------------------------------------------------------------------------
API_PORT=3000
API_DATABASE_URL=file:./data/api.db
# Base URL of the Python engine as seen from the API process (full mode).
CONVERTER_INTERNAL_URL=http://localhost:8000
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=7d
# Sessão local: cada navegador tem seu owner (cookie HttpOnly + device id).
# Não há cadastro/login/senha. `required` aceita JWT de emissor confiável.
# optional | required
AUTH_MODE=optional
# 50 MiB
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_PAGES=500
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Python converter
# ---------------------------------------------------------------------------
CONVERTER_PORT=8000
CONVERTER_DATABASE_URL=sqlite:///./data/converter.db
CONVERTER_INTERNAL_TOKEN=dev-internal-token-change-me
CONVERTER_QUEUE=inline         # inline | celery
CONVERTER_WORKERS=2
CONVERTER_TASK_TIMEOUT_SECONDS=600
CONVERTER_MAX_PAGES=500
CONVERTER_MAX_PDF_BYTES=52428800
CONVERTER_RENDER_DPI=300
CONVERTER_OCR_ENABLED=true
# Path to the tesseract binary when it is not on PATH (Windows example below).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CONVERTER_OCR_MIN_CONFIDENCE=0.45
CONVERTER_OCR_MAX_PIXELS=40000000
CONVERTER_MAX_FALLBACK_ATTEMPTS=2
# Motor preferencial: glm-ocr | rapidocr | tesseract (vazio = automatico:
# glm-ocr quando o Ollama estiver no ar com o modelo, senao os demais)
#CONVERTER_OCR_ENGINE=

# --- OCR: GLM-OCR (VLM local via Ollama, 100% GPU) -------------------------
# Motor preferencial para paginas digitalizadas (GLM-OCR via Ollama).
# Instale o modelo com:  ollama pull glm-ocr:latest
# A GPU e usada automaticamente pelo Ollama quando ha VRAM (verifique: ollama ps).
GLMOCR_ENABLED=true
GLMOCR_HOST=127.0.0.1
GLMOCR_PORT=11434
GLMOCR_MODEL=glm-ocr:latest
GLMOCR_REQUEST_TIMEOUT=300
GLMOCR_NUM_CTX=8192
GLMOCR_NUM_PREDICT=4096
GLMOCR_KEEP_ALIVE=30m
# Vazio = offload automatico de todas as camadas para a GPU (recomendado)
#GLMOCR_NUM_GPU=
# Confianca constante atribuida as palavras do VLM (sem confianca por token)
GLMOCR_CONFIDENCE=0.90
GLMOCR_PROBE_CACHE_SECONDS=60

# ---------------------------------------------------------------------------
# Generalized formats (same IR, no repeated OCR)
# ---------------------------------------------------------------------------
CONVERTER_TARGET_FORMATS=xlsx,txt,csv
CONVERTER_MAX_IMAGE_FRAMES=500
CONVERTER_MAX_IMAGE_MEGAPIXELS=40
CONVERTER_MAX_JOB_MEGAPIXELS=200

# ---------------------------------------------------------------------------
# Local assistant: Qwen3.5-4B via Ollama (optional; conversions never depend)
#   ollama pull qwen3.5:4b
# The GUI never downloads a model on page load.
# ---------------------------------------------------------------------------
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=ollama
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=11434
ASSISTANT_MODEL=qwen3.5:4b
ASSISTANT_CONTEXT_TOKENS=8192
ASSISTANT_MAX_OUTPUT_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_MAX_CONCURRENT=1
# Qwen3.5 emits a long thinking stream by default; keep it off so the answer
# is not starved of output tokens.
ASSISTANT_THINKING=false
ASSISTANT_REQUIRE_SOURCES=true
EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Storage: local | s3
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pdf2x
S3_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL / Redis (full mode)
# ---------------------------------------------------------------------------
POSTGRES_USER=pdf2x
POSTGRES_PASSWORD=pdf2x
POSTGRES_DB=pdf2x
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used only by apps/api/prisma/schema.postgres.prisma
API_POSTGRES_URL=postgresql://pdf2x:pdf2x@postgres:5432/pdf2x?schema=api
# Converter Postgres (read as CONVERTER_DATABASE_URL, see infra/docker-compose.yml):
# CONVERTER_DATABASE_URL=postgresql+psycopg://pdf2x:pdf2x@postgres:5432/pdf2x_conv
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Retention / privacy
# ---------------------------------------------------------------------------
RETENTION_PDF_DAYS=7
RETENTION_XLSX_DAYS=30
RETENTION_AUDIT_DAYS=90
ARTIFACT_COMPRESSION=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Structured JSON logs in the converter (1/true/yes).
# LOG_JSON=1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Production checklist (change every placeholder before deploying)
#   - JWT_SECRET                : long random string (API and converter share it)
#   - CONVERTER_INTERNAL_TOKEN  : long random string, shared API <-> converter
#   - ALLOWED_ORIGINS           : include the Vercel origin, e.g.
#                                 https://<project>.vercel.app (no trailing slash).
#                                 Set it on BOTH the API and the converter.
#   - PUBLIC_API_URL            : public https URL of the API
#   - WEB_ORIGIN                : public https URL of the SPA
#   - S3_* / POSTGRES_* / API_POSTGRES_URL / CONVERTER_DATABASE_URL : real
#                                 credentials, never the local defaults
#   - Frontend (Vercel build)   : VITE_API_BASE=https://<backend-host>/api/v1
#                                 (set in Vercel project env, not in this file)
# ---------------------------------------------------------------------------
